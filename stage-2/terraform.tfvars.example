# -------- Service config --------
service_name   = "sample-app"
container_name = "sample-app"
container_port = 3000

cpu    = "256"
memory = "512"

image_tag         = "latest"
health_check_path = "/health"
desired_count     = 1

# -------- ALB routing --------
listener_priority = 100
path_patterns     = ["/sample/*"]

# -------- Logging --------
log_retention_in_days = 14

# -------- Stage 1 outputs --------
vpc_id = "vpc-xxxxxxxx"

private_subnet_ids = [
  "subnet-xxxxxxxx",
  "subnet-yyyyyyyy"
]

alb_security_group_id = "sg-xxxxxxxx"

http_listener_arn = "arn:aws:elasticloadbalancing:region:account-id:listener/app/alb-name/xxx/yyy"

ecs_cluster_arn = "arn:aws:ecs:region:account-id:cluster/cluster-name"

# -------- IAM roles --------
execution_role_arn = "arn:aws:iam::account-id:role/ecsTaskExecutionRole"
task_role_arn      = "arn:aws:iam::account-id:role/sample-task-role"

# -------- Region --------
aws_region = "us-east-1"